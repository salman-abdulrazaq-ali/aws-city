  "awsDefaultsNote": "Things AWS makes in every account and Region on its own (Resource Explorer lists them): never the player's, so My AWS and the city leave them out. 'service:resource' from the ARN; a trailing * matches any rest. Seen 24 Nov 2026 in a fresh account (…8585, us-west-2): EventBridge, Athena and ElastiCache appeared, with an S3 -> EventBridge line.",
  "awsDefaults": [
    { "pattern": "events:event-bus/default", "why": "Every Region's default event bus" },
    { "pattern": "scheduler:schedule-group/default", "why": "EventBridge Scheduler's default schedule group" },
    { "pattern": "athena:workgroup/primary", "why": "Athena's default workgroup" },
    { "pattern": "athena:datacatalog/AwsDataCatalog", "why": "The Glue Data Catalog as Athena lists it" },
    { "pattern": "elasticache:user:default", "why": "ElastiCache's reserved default user" },
    { "pattern": "elasticache:user:default.iam-user", "why": "ElastiCache's default IAM user" },
    { "pattern": "elasticache:usergroup:default.iam-user-group", "why": "ElastiCache's default IAM user group" },
    { "pattern": "memorydb:acl/open-access", "why": "MemoryDB's built-in open-access ACL" },
    { "pattern": "memorydb:user/default", "why": "MemoryDB's reserved default user" },
    { "pattern": "memorydb:parametergroup/default.*", "why": "MemoryDB's default parameter groups" },
    { "pattern": "xray:group/Default", "why": "X-Ray's default group" },
    { "pattern": "xray:sampling-rule/Default", "why": "X-Ray's default sampling rule" },
    { "pattern": "apprunner:autoscalingconfiguration/DefaultConfiguration/*", "why": "App Runner's default auto scaling configuration" },
    { "pattern": "kms:alias/aws/*", "why": "Aliases of AWS managed keys (aws/s3, aws/ebs…)" }
  ]
}
