{
  "asOf": "2026-10-10",
  "note": "Maps an ARN's service (and, where it matters, its resource type) to the city landmark it belongs to. 'service:type' wins over 'service'. Anything not listed is drawn as a '?' lot. ARN format: https://docs.aws.amazon.com/IAM/latest/UserGuide/reference-arns.html",
  "map": {
    "ec2": "ec2",
    "ec2:instance": "ec2",
    "ec2:volume": "ebs",
    "ec2:snapshot": "ebs",
    "ec2:vpc": "vpc",
    "ec2:subnet": "vpc",
    "ec2:security-group": "vpc",
    "ec2:internet-gateway": "vpc",
    "ec2:natgateway": "vpc",
    "ec2:route-table": "vpc",
    "ec2:network-acl": "vpc",
    "ec2:vpc-endpoint": "vpc",
    "ec2:dhcp-options": "vpc",
    "lambda": "lambda",
    "ecs": "ecs",
    "eks": "eks",
    "elasticbeanstalk": "beanstalk",
    "s3": "s3",
    "elasticfilesystem": "efs",
    "glue": "glue",
    "athena": "athena",
    "lakeformation": "lakeformation",
    "dynamodb": "dynamodb",
    "rds": "rds",
    "rds:cluster": "aurora",
    "elasticache": "elasticache",
    "redshift": "redshift",
    "redshift-serverless": "redshift",
    "neptune-graph": "neptune",
    "route53": "route53",
    "cloudfront": "cloudfront",
    "apigateway": "apigateway",
    "execute-api": "apigateway",
    "sqs": "sqs",
    "sns": "sqs",
